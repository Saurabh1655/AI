def depth_limited_search(current, goal, limit, path, visited):
  if current == goal:
    return path
  if limit <= 0:
    return None
  if current in romania_map:
    for neighbor, cost in romania_map[current]:
      if neighbor not in visited:
        visited.add(neighbor)
        new_path = path + [(neighbor, cost)]
        result = depth_limited_search(neighbor, goal, limit - 1, new_path, visited)
        if result is not None:
          return result
        visited.remove(neighbor)
  return None
def iterative_deepening_dfs(start, goal, max_depth):
  for depth in range(max_depth + 1):
    visited = {start}
    result = depth_limited_search(start, goal, depth, [(start, 0)], visited)
    if result is not None:
      return result
  return None
