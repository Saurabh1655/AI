Aim: Aim: Write a program to implement the Expectation-Maximization (EM) 
algorithm for learning with hidden variables.

import numpy as np
X = np.array([10, 11, 12, 20, 21, 22], dtype=float)
k = 2
means = np.array([11.0, 21.0])
variances = np.array([1.0, 1.0])
weights = np.array([0.5, 0.5])
def gaussian(x, mean, variance):
    return (1 / np.sqrt(2 * np.pi * variance)) * np.exp(-((x - mean) ** 2) / (2 * variance))
for iteration in range(10):
    responsibilities = np.zeros((len(X), k))
    for i in range(len(X)):
        for j in range(k):
            responsibilities[i, j] = weights[j] * gaussian(X[i], means[j], variances[j])
        responsibilities[i] /= np.sum(responsibilities[i])
    Nk = np.sum(responsibilities, axis=0)
    means = np.sum(responsibilities * X[:, np.newaxis], axis=0) / Nk
    variances = np.sum(responsibilities * (X[:, np.newaxis] - means) ** 2, axis=0) / Nk
    weights = Nk / len(X)
    print("\nIteration:", iteration + 1)
    print("Means:", means)
    print("Variances:", variances)
    print("Weights:", weights)
print("\nFinal Responsibilities:")
print(responsibilities)
print("\nFinal Means:")
print(means)
print("\nFinal Variances:")
print(variances)
print("\nFinal Weights:")
print(weights)


