plt.plot([1, 2, 3], numeric_result, marker="o", linestyle="-", color="b")
plt.yticks([0, 1], ["Playing", "Strong/Playing (0)", "Studying (1)"])  # Adjust labels if needed
plt.title("HMM State Estimation")
