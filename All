def bfs(graph, start, goal):
  visited = set()
  queue = deque([[start]])
  while queue:
    path = queue.popleft()
    node = path[-1]
    if node == goal:
      return path
    if node not in visited:
      visited.add(node)
      for neighbor in graph[node]:
        if neighbor not in visited:
          new_path = list(path)
          new_path.append(neighbor)
          queue.append(new_path)
  return None
