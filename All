# Objective Function
def objective_function(x):
    return -(x - 3) ** 2 + 9

# Hill Climbing Algorithm
def hill_climbing(start, step_size, max_iterations):
    current = start
    current_value = objective_function(current)

    print(f"Initial Position = {current}")
    print(f"Initial Value = {current_value}")
    print("-" * 40)

    for i in range(max_iterations):
        # Generate neighbors
        left = current - step_size
        right = current + step_size

        # Evaluate neighbors
        left_value = objective_function(left)
        right_value = objective_function(right)

        print(f"Iteration {i+1}")
        print(f"Current Position = {current}, Value = {current_value}")
        print(f"Left Neighbor = {left}, Value = {left_value}")
        print(f"Right Neighbor = {right}, Value = {right_value}")

        # Move to better neighbor
        if left_value > current_value:
            current, current_value = left, left_value
            print("Move Left")
        elif right_value > current_value:
            current, current_value = right, right_value
            print("Move Right")
        else:
            print("No Better Neighbor Found")
            print("Stopping Search...")
            break

        print("-" * 40)

    return current, current_value

# Main Program
