import random
class VacuumEnvironment:
  def __init__(self):
    self.location_status = {
        "A": random.choice([True, False]),
        "B": random.choice([True, False]),
    }
    self.agent_location = "A"
    self.performance_score = 0
  def get_percept(self):
    return self.agent_location, self.location_status[self.agent_location]
  def execute_action(self, action):
    location, is_dirty = self.get_percept()
    if action == "Suck":
      if is_dirty:
        self.location_status[location] = False
        self.performance_score += 100
        print(f"Action: SUCK in {location}. Cleaned.")
      else:
        self.performance_score -= 1
        print(f"Action: SUCK in {location}. Already clean.")
    elif action == "MoveRight" and location == "A":
      self.agent_location = "B"
      self.performance_score -= 1
      print("Action: MOVE RIGHT to B.")
    elif action == "MoveLeft" and location == "B":
      self.agent_location = "A"
      self.performance_score -= 1
      print("Action: MOVE LEFT to A.")
  def get_state(self):
    return self.location_status
def simple_reflex_agent(percept):
  location, is_dirty = percept
  if is_dirty:
    return "Suck"
  elif location == "A":
    return "MoveRight"
  elif location == "B":
    return "MoveLeft"
env = VacuumEnvironment()
for step in range(4):
  print(f"Step {step + 1}: State={env.get_state()}")
  action = simple_reflex_agent(env.get_percept())
  env.execute_action(action)
print(f"Final Score: {env.performance_score}")

