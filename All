import math

def win(b):
    w = [
        (0,1,2), (3,4,5), (6,7,8),
        (0,3,6), (1,4,7), (2,5,8),
        (0,4,8), (2,4,6)
    ]
    for a, c, d in w:
        if b[a] == b[c] == b[d] and b[a] != " ":
            return b[a]
    return None

def minimax(b, max_player):
    result = win(b)
    if result == "O":
        return 1
    if result == "X":
        return -1
    if " " not in b:
        return 0

    if max_player:  # AI turn
        best = -math.inf
        for i in range(9):
            if b[i] == " ":
                b[i] = "O"
                score = minimax(b, False)
                b[i] = " "
                best = max(best, score)
        return best
    else:  # Human turn
        best = math.inf
        for i in range(9):
            if b[i] == " ":
                b[i] = "X"
                score = minimax(b, True)
                b[i] = " "
                best = min(best, score)
        return best

def best_move(b):
    best = -math.inf
    move = 0
    for i in range(9):
        if b[i] == " ":
            b[i] = "O"
            score = minimax(b, False)
            b[i] = " "
            if score > best:
                best = score
                move = i
    return move

