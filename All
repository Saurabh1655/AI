# 3. A* Search Algorithm Function
def a_star(graph, heuristic, start, goal):
  # Open list stores tuples of (f_cost, current_node)
  open_list = []
  heapq.heappush(open_list, (0 + heuristic[start], start))
  # g_cost stores the shortest known distance from start to each node
  g_cost = {start: 0}
  # Parent dictionary for path reconstruction
  parent = {start: None}
  # Closed set to store already explored nodes
  closed = set()
  while open_list:
    f, current = heapq.heappop(open_list)
    # If goal is reached, reconstruct the path
    if current == goal:
      path = []
      while current:
        path.append(current)
        current = parent[current]
      path.reverse()
      return path, g_cost[goal]
    # Ignore already processed nodes
    if current in closed:
      continue
    closed.add(current)
    # Explore neighbors
    for neighbor, weight in graph[current].items():
      tentative_g = g_cost[current] + weight
      # If a shorter path to neighbor is found or neighbor not visited yet
      if neighbor not in g_cost or tentative_g < g_cost[neighbor]:
        g_cost[neighbor] = tentative_g
        f_cost = tentative_g + heuristic[neighbor]
        parent[neighbor] = current
        heapq.heappush(open_list, (f_cost, neighbor))
  return None, float("inf")
# 4. Execute the Algorithm
