# HIDDEN MARKOV MODEL (HMM) - STATE ESTIMATION
# =========================================================

import matplotlib.pyplot as plt

# 1. Define the hidden states of the student
states = ["Studying", "Playing"]

# 2. Define the initial state probabilities
initial = {"Studying": 0.6, "Playing": 0.4}
# 60% chance of Studying and 40% chance of Playing

# 3. Define transition probabilities
trans = {
    "Studying": {"Studying": 0.8, "Playing": 0.2},
    "Playing": {"Studying": 0.3, "Playing": 0.7},
}

# 4. Define emission probabilities
emit = {
    "Studying": {"Low": 0.9, "High": 0.1},
    "Playing": {"Low": 0.2, "High": 0.8},
}

# 5. Observations received for 3 days
obs = ["Low", "High", "High"]


def viterbi(obs_sequence):
  """Finds the most likely sequence of hidden states using the Viterbi algorithm."""
  prob = [{}]
  path = {}

  # Initialize base cases (t = 0)
  for s in states:
    prob[0][s] = initial[s] * emit[s][obs_sequence[0]]
    path[s] = [s]

  # Run Viterbi for t > 0
  for t in range(1, len(obs_sequence)):
    prob.append({})
    new_path = {}

    for s in states:
      # Find the previous state with the highest probability
      p, prev = max(
          (prob[t - 1][p] * trans[p][s], p) for p in states
      )
      # Calculate probability for the current state
      prob[t][s] = p * emit[s][obs_sequence[t]]
      new_path[s] = path[prev] + [s]

    path = new_path

  # Find the final state with the highest probability
  final_state = max(states, key=lambda s: prob[-1][s])
  return path[final_state], prob[-1][final_state]


# Run the Viterbi algorithm
result, probability = viterbi(obs)

# Display the results
print("Observations:", obs)
print("Predicted states:", result)
print("Probability:", probability)

for i in range(len(obs)):
  print(f"Day {i+1} : {obs} === {result[i]}")

